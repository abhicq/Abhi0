# ── Core ──────────────────────────────────────────────────────────────
PORT=3000
BASE_URL=http://localhost:3000          # public URL for OAuth redirect + tracking links (auto-detected on Vercel)
JWT_SECRET=change-me-long-random-string
ENCRYPTION_KEY=change-me-another-long-random-string   # encrypts Google OAuth tokens at rest
# Database (libSQL). Leave empty locally → ./data/rankpilot.db
# Production/Vercel: create a Turso DB (or add Turso from the Vercel Marketplace, which sets these for you)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# DB_PATH=./data/rankpilot.db
CRON_SECRET=change-me-random-string     # protects /api/cron/tick (Vercel Cron sends it automatically)
# SCHEDULER_INTERVAL_MS=60000
# AUTOPILOT_EVERY_HOURS=6
# DISABLE_SCHEDULER=1                   # set when running `node src/scheduler.js` as a separate worker

# ── Google Business Profile (leave empty = demo mode) ────────────────
# Enable: My Business Account Management, Business Information, Google My Business (v4),
# Business Profile Performance APIs. GBP API access must be approved by Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# ── AI content (Claude) ───────────────────────────────────────────────
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# ── Rank tracking + keyword volumes (DataForSEO) ─────────────────────
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# ── Billing (Stripe) ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
