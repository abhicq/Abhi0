{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": { "maxDuration": 300 }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/t/(.*)", "destination": "/api" }
  ],
  "crons": [
    { "path": "/api/cron/tick", "schedule": "17 14 * * *" }
  ]
}
